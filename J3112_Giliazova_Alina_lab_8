// Реализация поиска пути с помощью BFS
vector<Node*> bfs(Node *start, Node *goal) {
    if (!start || !goal) { // Проверка наличия начального и конечного узлов
        return {};
    }

    queue<Node*> queue; // Очередь для хранения узлов, которые нужно посетить
    unordered_map<Node*, Node*> came_from; // Хранит информацию, откуда мы пришли в данный узел
    unordered_map<Node*, bool> visited; // Хранит информацию о посещенных узлах

    queue.push(start); // Добавляем начальный узел в очередь
    visited[start] = true; // Помечаем начальный узел как посещенный

    while (!queue.empty()) {
        Node* current = queue.front(); // Извлекаем текущий узел из очереди
        queue.pop();

        if (current == goal) { // Если достигли цели
            vector<Node*> path;
            for (Node* at = goal; at != nullptr; at = came_from[at]) { // Восстанавливаем путь от цели до начала
                path.push_back(at);
            }
            reverse(path.begin(), path.end()); // Переворачиваем путь
            return path; // Возвращаем найденный путь
        }

        for (const auto& edge : current->edges) { // Итерируем по всем соседям текущего узла
            Node* neighbor = edge.first;
            if (!visited[neighbor]) { // Если сосед не был посещен
                queue.push(neighbor); // Добавляем его в очередь
                visited[neighbor] = true; // Помечаем его как посещенный
                came_from[neighbor] = current; // Записываем, откуда мы пришли
            }
        }
    }

    return {}; // Возвращаем пустой путь
}

// Реализация поиска пути с помощью DFS
vector<Node*> dfs(Node* start, Node* goal) {
    if (!start || !goal) { // Проверка наличия начального и конечного узлов
        return {};
    }

    unordered_map<Node*, bool> visited; // Хранит информацию о посещенных узлах
    unordered_map<Node*, Node*> came_from; // Хранит информацию, откуда мы пришли в данный узел
    stack<Node*> stack; // Стек для хранения узлов, которые нужно посетить

    stack.push(start); // Добавляем начальный узел в стек
    visited[start] = true; // Помечаем начальный узел как посещенный

    while (!stack.empty()) {
        Node* current = stack.top(); // Извлекаем текущий узел из стека
        stack.pop();

        if (current == goal) { // Если достигли цели
            vector<Node*> path;
            for (Node* at = goal; at != nullptr; at = came_from[at]) { // Восстанавливаем путь от цели до начала
                path.push_back(at);
            }
            reverse(path.begin(), path.end()); // Переворачиваем путь
            return path; // Возвращаем найденный путь
        }

        for (const auto& edge : current->edges) { // Итерируем по всем соседям текущего узла
            Node* neighbor = edge.first;
            if (!visited[neighbor]) { // Если сосед не был посещен
                stack.push(neighbor); // Добавляем его в стек
                visited[neighbor] = true; // Помечаем его как посещенный
                came_from[neighbor] = current; // Записываем, откуда мы пришли
            }
        }
    }

    return {}; // Возвращаем пустой путь
}

// Реализация поиска кратчайшего пути с помощью алгоритма Дейкстры
vector<Node*> dijkstra(Graph& graph, Node* start, Node* goal) {
    if (!start || !goal) { // Проверка наличия начального и конечного узлов
        return {};
    }

    unordered_map<Node*, double> distances; // Хранит минимальные расстояния до каждого узла
    unordered_map<Node*, Node*> came_from; // Хранит информацию, откуда мы пришли в данный узел
    unordered_map<Node*, bool> visited; // Хранит информацию о посещенных узлах

    // Инициализация расстояний до всех узлов как бесконечность
    for (const auto& node : graph.nodes) {
        distances[node.get()] = numeric_limits<double>::infinity();
    }
    distances[start] = 0.0; // Расстояние до начального узла равно 0

    using PQElement = pair<double, Node*>; // Тип элемента для очереди: пара (расстояние, узел)
    priority_queue<PQElement, vector<PQElement>, greater<>> pq; // Очередь с приоритетом (по минимальному расстоянию)
    pq.emplace(0.0, start); // Добавляем начальный узел в очередь

    while (!pq.empty()) {
        auto [current_distance, current_node] = pq.top(); // Извлекаем узел с минимальным расстоянием
        pq.pop();

        if (visited[current_node]) { // Если узел уже был обработан, пропускаем его
            continue;
        }
        visited[current_node] = true; // Помечаем узел как посещенный

        if (current_node == goal) { // Если достигли цели
            vector<Node*> path;
            for (Node* at = goal; at != nullptr; at = came_from[at]) { // Восстанавливаем путь от цели до начала
                path.push_back(at);
            }
            reverse(path.begin(), path.end()); // Переворачиваем путь
            return path; // Возвращаем найденный путь
        }

        // Обновляем расстояния до соседей
        for (const auto& edge : current_node->edges) {
            Node* neighbor = edge.first;
            double weight = edge.second;

            double new_distance = current_distance + weight; // Новое расстояние до соседа
            if (new_distance < distances[neighbor]) { // Если нашли более короткий путь
                distances[neighbor] = new_distance; // Обновляем расстояние
                came_from[neighbor] = current_node; // Записываем, откуда мы пришли
                pq.emplace(new_distance, neighbor); // Добавляем соседа в очередь
            }
        }
    }

    return {}; // Возвращаем пустой путь
}

// Функция эвристики для алгоритма A*
// Возвращает евклидово расстояние между двумя узлами.
// Используется как приближенная оценка расстояния от текущего узла до цели.
double heuristic(Node* a, Node* b) {
    return sqrt(pow(a->latitude - b->latitude, 2) + pow(a->longitude - b->longitude, 2));
}

// Реализация поиска кратчайшего пути с помощью алгоритма A*
vector<Node*> aStar(Graph& graph, Node* start, Node* goal) {
    if (!start || !goal) { // Проверка наличия начального и конечного узлов
        return {};
    }

    unordered_map<Node*, double> gScore; // Расстояние от начального узла до текущего
    unordered_map<Node*, double> fScore; // Оценка полного расстояния через текущий узел (gScore + эвристика)
    unordered_map<Node*, Node*> came_from; // Хранит информацию, откуда мы пришли в данный узел

    // Инициализация расстояний до всех узлов как бесконечность
    for (const auto& node : graph.nodes) {
        gScore[node.get()] = numeric_limits<double>::infinity();
        fScore[node.get()] = numeric_limits<double>::infinity();
    }
    gScore[start] = 0.0; // Расстояние до начального узла равно 0
    fScore[start] = heuristic(start, goal); // Оценка полного расстояния от начального узла

    using PQElement = pair<double, Node*>; // Тип элемента для очереди: пара (fScore, узел)
    priority_queue<PQElement, vector<PQElement>, greater<>> openSet; // Очередь с приоритетом
    openSet.emplace(fScore[start], start); // Добавляем начальный узел в очередь

    while (!openSet.empty()) {
        Node* current = openSet.top().second; // Извлекаем узел с минимальным значением fScore
        openSet.pop();

        if (current == goal) { // Если достигли цели
            vector<Node*> path;
            for (Node* at = goal; at != nullptr; at = came_from[at]) { // Восстанавливаем путь от цели до начала
                path.push_back(at);
            }
            reverse(path.begin(), path.end()); // Переворачиваем путь
            return path; // Возвращаем найденный путь
        }

        // Обрабатываем всех соседей текущего узла
        for (const auto& edge : current->edges) {
            Node* neighbor = edge.first;
            double weight = edge.second;

            double tentative_gScore = gScore[current] + weight; // Предполагаемое расстояние до соседа
            if (tentative_gScore < gScore[neighbor]) { // Если нашли более короткий путь
                came_from[neighbor] = current; // Записываем, откуда мы пришли
                gScore[neighbor] = tentative_gScore; // Обновляем gScore для соседа
                fScore[neighbor] = tentative_gScore + heuristic(neighbor, goal); // Обновляем fScore для соседа

                openSet.emplace(fScore[neighbor], neighbor); // Добавляем соседа в очередь
            }
        }
    }

    return {}; // Возвращаем пустой путь
}

// Тестирование
void TestBFS() {
    Graph testGraph;

    Node* nodeA = testGraph.addNode(0.0, 0.0);
    Node* nodeB = testGraph.addNode(1.0, 0.0);
    Node* nodeC = testGraph.addNode(0.0, 1.0);

    nodeA->edges.emplace_back(nodeB, 1.0);
    nodeB->edges.emplace_back(nodeC, 1.0);

    vector<Node*> path = bfs(nodeA, nodeC);

    assert(path.size() == 3);
    assert(path[0] == nodeA);
    assert(path[1] == nodeB);
    assert(path[2] == nodeC);

    cout << "BFS test passed!" << endl;
}

void TestDFS() {
    Graph testGraph;

    Node* nodeA = testGraph.addNode(0.0, 0.0);
    Node* nodeB = testGraph.addNode(1.0, 0.0);
    Node* nodeC = testGraph.addNode(0.0, 1.0);

    nodeA->edges.emplace_back(nodeB, 1.0);
    nodeB->edges.emplace_back(nodeC, 1.0);

    vector<Node*> path = dfs(nodeA, nodeC);

    assert(path.size() == 3);
    assert(path[0] == nodeA);
    assert(path[1] == nodeB);
    assert(path[2] == nodeC);

    cout << "DFS test passed!" << endl;
}

void TestDijkstra() {
    Graph testGraph;

    Node* nodeA = testGraph.addNode(0.0, 0.0);
    Node* nodeB = testGraph.addNode(1.0, 0.0);
    Node* nodeC = testGraph.addNode(0.0, 1.0);
    Node* nodeD = testGraph.addNode(1.0, 1.0);

    nodeA->edges.emplace_back(nodeB, 1.0);
    nodeB->edges.emplace_back(nodeD, 2.0);
    nodeA->edges.emplace_back(nodeC, 1.0);
    nodeC->edges.emplace_back(nodeD, 1.0);

    vector<Node*> path = dijkstra(testGraph, nodeA, nodeD);

    assert(path.size() == 3);
    assert(path[0] == nodeA);
    assert(path[1] == nodeC);
    assert(path[2] == nodeD);

    cout << "Dijkstra test passed!" << endl;
}

void TestAStar() {
    Graph testGraph;

    Node* nodeA = testGraph.addNode(0.0, 0.0);
    Node* nodeB = testGraph.addNode(1.0, 0.0);
    Node* nodeC = testGraph.addNode(0.0, 1.0);
    Node* nodeD = testGraph.addNode(1.0, 1.0);

    nodeA->edges.emplace_back(nodeB, 1.0);
    nodeB->edges.emplace_back(nodeD, 2.0);
    nodeA->edges.emplace_back(nodeC, 1.0);
    nodeC->edges.emplace_back(nodeD, 1.0);

    vector<Node*> path = aStar(testGraph, nodeA, nodeD);

    assert(path.size() == 3);
    assert(path[0] == nodeA);
    assert(path[1] == nodeC);
    assert(path[2] == nodeD);

    cout << "A* test passed!" << endl;
}

