struct Node {
    double longitude, latitude; // Координаты узла (долгота и широта)
    vector<pair<Node*, double>> edges; // Список смежных узлов с весами ребер
};

struct Graph {
    vector<unique_ptr<Node>> nodes; // Хранилище всех узлов графа
    unordered_map<string, Node*> node_map; // Хеш-таблица для быстрого доступа к узлам по их координатам

    // Добавить узел в граф
    Node* addNode(double longitude, double latitude);

    // Получить узел по заданным координатам
    Node* getNode(double longitude, double latitude);

    // Загрузить граф из файла
    void readFromFile(const string& filename);

    // Найти ближайший узел к заданным координатам
    Node* findClosestNode(double latitude, double longitude) const;

    // Напечатать путь и его длину
    void printPath(const vector<Node*>& path);
};

// Реализация метода для добавления узла в граф
Node* Graph::addNode(double longitude, double latitude) {
    auto node = make_unique<Node>(Node{longitude, latitude});
    Node* node_ptr = node.get();
    nodes.push_back(std::move(node));

    // Формируем строковый ключ на основе координат узла
    ostringstream key_stream;
    key_stream << fixed << setprecision(10) << longitude << "," << latitude;
    string key = key_stream.str();

    // Сохраняем узел в хеш-таблицу для быстрого доступа
    node_map[key] = node_ptr;
    return node_ptr;
}

// Реализация метода для получения узла по координатам
Node* Graph::getNode(double longitude, double latitude) {
    // Формируем строковый ключ на основе координат
    ostringstream key_stream;
    key_stream << fixed << setprecision(10) << longitude << "," << latitude;
    string key = key_stream.str();

    // Проверяем наличие узла в хеш-таблице
    if (node_map.find(key) != node_map.end()) {
        return node_map[key]; // Если узел найден, возвращаем указатель на него
    }
    return nullptr; // Если узел не найден, возвращаем nullptr
}

// Реализация метода для чтения графа из файла
void Graph::readFromFile(const string& filename) {
    ifstream file(filename);
    string line;

    while (getline(file, line)) {
        istringstream line_stream(line);
        string parent_data, edges_data;

        // Парсим данные родительского узла
        if (getline(line_stream, parent_data, ':')) {
            double longitude1, latitude1;
            replace(parent_data.begin(), parent_data.end(), ',', ' ');
            istringstream parent_stream(parent_data);

            // Извлекаем координаты родительского узла
            if (!(parent_stream >> longitude1 >> latitude1)) {
                cerr << "Ошибка парсинга координат родительского узла: " << parent_data << endl;
                continue;
            }

            // Получаем или создаем родительский узел
            Node* parent_node = getNode(longitude1, latitude1);
            if (!parent_node) {
                parent_node = addNode(longitude1, latitude1);
            }

            // Парсим данные о смежных узлах (ребрах)
            while (getline(line_stream, edges_data, ';')) {
                double longitude2, latitude2, weight;
                replace(edges_data.begin(), edges_data.end(), ',', ' ');
                istringstream edge_stream(edges_data);

                // Извлекаем координаты и вес ребра
                if (!(edge_stream >> longitude2 >> latitude2 >> weight)) {
                    cerr << "Ошибка парсинга данных ребра: " << edges_data << endl;
                    continue;
                }

                // Получаем или создаем дочерний узел
                Node* child_node = getNode(longitude2, latitude2);
                if (!child_node) {
                    child_node = addNode(longitude2, latitude2);
                }

                // Добавляем ребро между узлами (в обе стороны)
                parent_node->edges.emplace_back(child_node, weight);
                child_node->edges.emplace_back(parent_node, weight);
            }
        }
    }

    file.close();
}

// Реализация метода для вывода пути
void Graph::printPath(const vector<Node*>& path) {
    if (path.empty()) {
        cout << "Путь не найден.\n";
        return;
    }

    double total_length = 0.0;

    // Проходим по всем узлам в пути
    for (size_t i = 0; i < path.size(); ++i) {
        if (i < path.size() - 1) { // Если это не последний узел
            // Ищем вес ребра между текущим и следующим узлом
            for (const auto& edge : path[i]->edges) {
                if (edge.first == path[i + 1]) {
                    total_length += edge.second; // Добавляем вес ребра к общей длине
                    break;
                }
            }
        }
    }

    cout << "Общая длина пути: " << total_length << endl;
}

// Реализация метода для поиска ближайшего узла к заданным координатам
Node* Graph::findClosestNode(double latitude, double longitude) const {
    double minDistance = numeric_limits<double>::max(); // Переменная для хранения минимального расстояния
    Node* closestNode = nullptr; // Указатель на ближайший узел

    // Проходим по всем узлам в графе
    for (const auto& node : nodes) {
        // Вычисляем евклидово расстояние между заданными координатами и текущим узлом
        double distance = sqrt(pow(node->latitude - latitude, 2) + pow(node->longitude - longitude, 2));
        if (distance < minDistance) { // Если найдено меньшее расстояние
            closestNode = node.get(); // Обновляем ближайший узел
            minDistance = distance;
        }
    }

    return closestNode;
}

vector<Node*> bfs(Node *start, Node *goal);
vector<Node*> dfs(Node* start, Node* goal);
vector<Node*> dijkstra(Graph& graph, Node* start, Node* goal);
