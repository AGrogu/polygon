    const vector<Node *> a_star_path = aStar(graph, start_node, goal_node);
    end_time = high_resolution_clock::now();
    graph.printPath(a_star_path);
    auto a_star_duration = duration_cast<milliseconds>(end_time - start_time);
    cout << "Время выполнения: " << a_star_duration.count() << " мс" << endl;

    cout << "\nТесты:" << endl;

    TestBFS();
