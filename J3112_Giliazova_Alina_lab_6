#include <iostream>
#include <string>
#include <cstring>
using namespace std;

class Solution {
public:
    int countDigitOne(int n) {
        string num = to_string(n);
        int len = num.size();

        int dp[11][2][11];
        memset(dp, -1, sizeof(dp));

        function<int(int, bool, int)> solve = [&](int pos, bool tight, int count) {
            if (pos == len) {
                return count;
            }

            if (dp[pos][tight][count] != -1) {
                return dp[pos][tight][count];
            }

            int limit = tight ? (num[pos] - '0') : 9;
            int result = 0;

            for (int digit = 0; digit <= limit; ++digit) {
                result += solve(pos + 1, tight && (digit == limit), count + (digit == 1));
            }

            return dp[pos][tight][count] = result;
        };

        return solve(0, true, 0);
    }
};

int main() {
    int n;
    cout << "Введите число: ";
    cin >> n;

    Solution solution;
    cout << solution.countDigitOne(n) << endl;
    return 0;
}
